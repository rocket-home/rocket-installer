# rocket-installer — конфигурация машины (единственный источник правды).
# Правки: make env-set KEY=... VALUE=...  или через TUI (rocket).
# После правок: make gen-configs && make up

## Zigbee-стик
# Стабильный путь, который выбрал пользователь (символическая ссылка by-id или /dev/zigbee)
ZIGBEE_DEVICE_BYID=
# Реальный узел устройства на хосте (realpath; docker не принимает symlink как device)
ZIGBEE_DEVICE_HOST=/dev/ttyACM0
# Семейство адаптера: zstack | ember | deconz | zigate (из детекта или вручную)
ADAPTER_FAMILY=
# Значение serial.adapter для zigbee2mqtt (пусто = автодетект z2m)
Z2M_ADAPTER=
# Обнаруженная версия прошивки координатора (информационно + для resolve-tag)
FIRMWARE_VERSION=

## Образы (теги пиненые — обновление только осознанное, через make update)
Z2M_IMAGE_TAG=1.42.0
NODERED_IMAGE_TAG=4.0.9

## Облако rocket-home
# oauth (по умолчанию, линковка через make oauth-link) | static (креды с rocket-home.ru/profile/mqtt)
CLOUD_AUTH_MODE=oauth
CLOUD_MQTT_HOST=mq.rocket-home.ru
CLOUD_MQTT_PORT=8883
# mqttv311 — проверенный вариант для hmq; fallback при проблемах: mqttv31
CLOUD_BRIDGE_PROTOCOL=mqttv311
API_BASE_URL=https://rocket-home.ru
# public device-grant OAuth-клиент «Rocket Home Installer» (сидится миграцией Janus)
OAUTH_CLIENT_ID=
# Только для CLOUD_AUTH_MODE=static:
CLOUD_MQTT_USERNAME=
CLOUD_MQTT_PASSWORD=

## Локальный брокер (креды для z2m, node-red и диагностики; генерируются автоматически)
LOCAL_MQTT_USER=local
LOCAL_MQTT_PASSWORD=

## zigbee2mqtt
Z2M_BASE_TOPIC=zigbee2mqtt
Z2M_FRONTEND_PORT=4000
# Токен доступа к веб-интерфейсу z2m (генерируется автоматически; фронт слушает всю LAN)
Z2M_FRONTEND_AUTH_TOKEN=

## Аддоны
# "nodered" — включить Node-RED; пусто — выключен
COMPOSE_PROFILES=
# UID/GID владельца data/nodered (контейнер node-red работает не под root)
UID=1000
GID=1000
